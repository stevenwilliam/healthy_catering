# healthy_catering — documented configuration surface.
# Copy to .env and fill in. The real .env is git-ignored; nothing secret in git.
#
# Values are deliberately absent rather than wrong: the product brief has not
# landed, so the database name, port and domain are placeholders to be set.

# ── app ──────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8081
# Must be a host the browser actually reaches. Pointing this at a name that
# only resolves on the server silently breaks every emailed link.
APP_BASE_URL=http://127.0.0.1:8081

# ── database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://healthy_catering:CHANGE_ME@127.0.0.1:5432/healthy_catering?sslmode=disable
TEST_DATABASE_URL=postgres://healthy_catering:CHANGE_ME@127.0.0.1:5432/healthy_catering_test?sslmode=disable

# ── auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SIGNING_KEY=

# Encrypts staff 2FA secrets at rest, so a database dump does not hand over
# everyone's second factor. Generate with: openssl rand -base64 32
#
# LEAVE IT EMPTY AND 2FA IS SWITCHED OFF ENTIRELY — the routes disappear and
# the log says so at boot. That is deliberate: storing TOTP secrets in the
# clear would be worse than not offering the feature.
#
# CHANGING IT MAKES EVERY EXISTING ENROLMENT UNREADABLE. Staff would have to
# re-enrol from a recovery code, and a required role has no way back in. Treat
# it like the database password, not like a rotatable token.
TOTP_ENCRYPTION_KEY=

# ── mail ─────────────────────────────────────────────────────────────────────
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.invalid
SMTP_FROM_NAME=Evermore
SMTP_TLS=false

# ── object storage ───────────────────────────────────────────────────────────
S3_ENDPOINT=127.0.0.1:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=healthy-catering
S3_USE_SSL=false

# ── WhatsApp (WAHA) ──────────────────────────────────────────────────────────
# Gateway location and session also live in sys_parameters so they can change
# without a deploy; the env wins. The API KEY is env-only and never in a
# migration — a migration is a file in git.
#
# Leave the key empty and WhatsApp is off: no sender is built, so messages are
# never queued rather than queued and permanently failing.
WAHA_URL=http://127.0.0.1:3000
WAHA_SESSION=default
WAHA_API_KEY=

# ── Machine translation of public copy ───────────────────────────────────────
# The back office writes the home hero in Indonesian; English and Chinese are
# produced from it and can be overridden by hand (docs/11 §6).
#
# OFF by default, and off is a working state: with no provider the editor still
# saves Indonesian and still types the other two languages manually. Setting a
# provider only removes the manual step.
#
# google = Google Cloud Translation v2, which takes a plain API key. v2 rather
# than v3 because v3 wants a service account and OAuth for four strings.
# Billable per character — this is a real cost, not a free tier to leave on.
TRANSLATE_PROVIDER=
TRANSLATE_API_KEY=
